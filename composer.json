{
  "name": "webstrategy/ws-fa-to-svg",
  "description": "Replace Font Awesome icons with inline SVGs for PageSpeed.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "WebStrategy",
      "homepage": "https://wordpress-freelance.com/"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "10up/wp_mock": "0.5.0"
  },
  "autoload-dev": {
    "psr-4": {
      "WS_FA_To_SVG\\Tests\\Unit\\": "tests/unit/"
    }
  },
  "scripts": {
    "test":          "phpunit -c phpunit.xml",
    "test:coverage": "phpunit -c phpunit.xml --coverage-html coverage --coverage-clover clover.xml"
  },
  "config": {
    "sort-packages": true
  }
}
